# SQLite for local dev. Point this at a Postgres URL in production
# (postgresql://user:pass@host:5432/db) — the schema is provider-agnostic.
DATABASE_URL="file:./dev.db"

# Generate with: openssl rand -base64 32
JWT_SECRET="replace-with-a-32-byte-random-secret"

# Used to build invite links in emails/logs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
