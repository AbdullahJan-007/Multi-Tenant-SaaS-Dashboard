# Postgres connection string (Neon, Supabase, or any Postgres host).
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Generate with: openssl rand -base64 32
# On Windows PowerShell (no openssl): node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET="replace-with-a-32-byte-random-secret"

# Used to build invite links in emails/logs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
